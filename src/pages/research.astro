---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const cv = (await getCollection('cv')).map((e) => ({ id: e.id, ...e.data }));
const pick = (id: string) => cv.find((e) => e.id === id)!;

const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const fmt = (ym?: string) => (ym ? `${months[Number(ym.split('-')[1]) - 1]} ${ym.split('-')[0]}` : '');
const range = (e: { start?: string; end?: string }) => `${fmt(e.start)} – ${e.end ? fmt(e.end) : 'present'}`;

/* Edit freely: one entry per topic. */
const interests = [
  { title: 'Consciousness', text: 'What consciousness is, how it arises from activity in the brain, and how it can be measured in the lab.' },
  { title: 'Psychedelic science', text: 'Psychedelics as a tool for studying consciousness and as a possible treatment. I coordinated a uniMIND group of the MIND Foundation that ran a journal club on the topic.' },
  { title: 'Modelling the brain', text: 'How the brain gives rise to perception, thought and behaviour, studied with neuroimaging such as EEG and fMRI and with artificial neural networks as models of brain function.' },
  { title: 'Individual differences', text: 'How people differ in personality and related traits, measured beyond questionnaires: through behaviour, language and digital traces as well as physiological and neural data. My bachelor’s thesis looked for traces of self-esteem in the prompts people write to AI chatbots.' },
  { title: 'Environmental psychology', text: 'Why people do or do not act on climate change, and what supports pro-environmental behaviour. In a project with IPU e.V. we study whether experiencing connectedness with others at a congress increases pro-environmental behaviour.' },
  { title: 'Open science', text: 'Research that others can check and build on: preregistered studies, shared data and code, and replications. For me this runs through all of the topics above. Since June 2025 I coordinate the Open Science working group of PsyFaKo e.V.' },
];

type Exp = { title: string; org: string; place?: string; detail?: string; url?: string; when: string };
const experience: Exp[] = [
  { ...pick('hohenheim'), when: range(pick('hohenheim')) },
  { ...pick('ude-personality'), when: range(pick('ude-personality')) },
  {
    title: 'Bachelor’s thesis',
    org: 'University of Duisburg-Essen',
    detail: 'Traces of Self-Esteem in Human–AI Interaction: An Exploratory Study of Linguistic Cues in User Prompts.',
    url: 'https://osf.io/eyrfb/',
    when: 'May – Aug 2026',
  },
];
---
<Base title="Research" description="Research interests and experience of Julian Karcher, Research Master student in psychology at the University of Amsterdam.">
  <header class="page-head wrap">
    <h1>Research</h1>
    <p class="intro">I’m a Research Master student in Psychology at the University of Amsterdam, majoring in Brain and Cognition with a minor in Methods and Statistics.</p>
  </header>

  <div class="wrap">
    <section class="section" aria-label="Interests">
      <h2>Interests</h2>
      <dl class="interests">
        {interests.map((it) => (
          <div><dt>{it.title}</dt><dd>{it.text}</dd></div>
        ))}
      </dl>
    </section>

    <section class="section" aria-label="Experience">
      <h2>Experience</h2>
      <ol class="exp">
        {experience.map((e) => (
          <li>
            <div>
              <h3>{e.title}</h3>
              <p class="org">{e.org}{e.place && `, ${e.place}`}</p>
              {e.detail && <p class="muted">{e.detail}{e.url && <> <a href={e.url} target="_blank" rel="noopener">Read on OSF</a></>}</p>}
            </div>
            <p class="when num">{e.when}</p>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Base>

<style>
  .interests { margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px 40px; }
  .interests dt { font-weight: 600; font-stretch: 108%; font-size: 1.08rem; }
  .interests dd { margin: 6px 0 0; color: var(--ink-2); }

  .exp { list-style: none; margin: 0; padding: 0; display: grid; gap: 26px; }
  .exp li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 24px; }
  .exp h3 { font-size: 1.12rem; font-stretch: 108%; }
  .exp .org { margin-top: 4px; color: var(--ink-2); }
  .exp .muted { margin-top: 4px; font-size: .97rem; }
  .when { color: var(--ink-3); font-size: .93rem; white-space: nowrap; }

  @media (max-width: 700px) {
    .interests { grid-template-columns: 1fr; }
    .exp li { grid-template-columns: 1fr; gap: 4px; }
    .when { order: -1; }
  }
</style>
